{
  "name": "scoutvault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ask someone nearby to check a listing and pay for the reviewed report through Solana escrow.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4317",
    "check": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:contract": "node --test tests/contract/*.test.mjs",
    "test:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@fontsource/geist": "^5.2.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "@supabase/supabase-js": "2.119.2",
    "bs58": "6.0.0",
    "buffer": "^6.0.3",
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.65.0",
    "motion": "^12.23.24",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1",
    "tweetnacl": "1.0.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "^4.1.17",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
