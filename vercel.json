{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/", "has": [{ "type": "query", "key": "demo", "value": "local" }], "destination": "/demo/", "permanent": false }],
  "rewrites": [{ "source": "/((?!api/|assets/|downloads/|demo/|docs/|listings/|.well-known/|scoutvault.svg).*)", "destination": "/index.html" }],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "Permissions-Policy", "value": "camera=(self), geolocation=(self), microphone=(self)" }] }]
}
