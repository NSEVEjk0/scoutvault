[Unit]
Description=ScoutVault public TLS gateway
After=network-online.target scoutvault-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/scoutvault
ExecStart=/usr/bin/python3 /root/scoutvault/scripts/serve-gateway.py
Restart=always
RestartSec=8
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=append:/root/scoutvault/.local/gateway-service.log
StandardError=append:/root/scoutvault/.local/gateway-service.log

[Install]
WantedBy=multi-user.target
